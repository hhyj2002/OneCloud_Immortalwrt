# ===== USB 网卡 / 外接存储 =====
# 板载有线网卡由 target 内核内置（meson8b 的 CONFIG_DWMAC_MESON=y），
# LEDE 的 kmod-stmmac-core 只对 x86_64 / armsr 可见，这里不需要也不该写
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-asix=y
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
CONFIG_PACKAGE_kmod-usb-net-smsc95xx=y
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y

# ===== 强制排除导致报错的 NTFS 驱动（LEDE 历史坑，勿删）=====
# 这三个与内核自带 ntfs3 / ntfs3-mount 冲突，编进固件会在打包阶段报错
# CONFIG_PACKAGE_kmod-fs-ntfs3 is not set
# CONFIG_PACKAGE_kmod-fs-ntfs is not set
# CONFIG_PACKAGE_ntfs3-mount is not set

# ===== targets 层：iptables 全家桶（target ABI 绑定，跨源装不上）=====
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_ip6tables-nft=y
CONFIG_PACKAGE_iptables-mod-extra=y
CONFIG_PACKAGE_iptables-mod-conntrack-extra=y
CONFIG_PACKAGE_iptables-mod-tproxy=y
CONFIG_PACKAGE_iptables-mod-socket=y
CONFIG_PACKAGE_iptables-mod-iprange=y
CONFIG_PACKAGE_iptables-mod-physdev=y
CONFIG_PACKAGE_iptables-mod-nat-extra=y
CONFIG_PACKAGE_libstdcpp=y
# 注意：LEDE 的 iptables 1.8.7 没有拆出 xtables-nft / xtables-legacy 包，
# iptables-nft 依赖 iptables（legacy 版）即可共存；也不要写 iptables-zz-legacy，
# 那是 iptables 包的 PROVIDES 名，不是独立包

# ===== base 层入口包 =====
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_nftables-json=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_libopenssl-conf=y
CONFIG_PACKAGE_libopenssl-legacy=y
CONFIG_PACKAGE_wget-ssl=y

# ===== IPv6 =====
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_kmod-ip6tables-extra=y

# ===== 防火墙（fw4）=====
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-fib=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-nft-fullcone=y
CONFIG_PACKAGE_kmod-nf-reject=y
CONFIG_PACKAGE_kmod-nf-reject6=y

# ===== Fullcone NAT（第三方 fullconenat 应用用）=====
# LEDE 的两个 fullcone 包都是 KernelPackage，定义在 package/network/services 下，
# 不在 modules/*.mk 里，但确实存在
CONFIG_PACKAGE_kmod-ipt-fullconenat=y
CONFIG_PACKAGE_iptables-mod-fullconenat=y
# LEDE 没有 ip6tables-mod-fullconenat，不要写

# ===== 科学上网底层 kmod =====
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-ipt-core=y
CONFIG_PACKAGE_kmod-ipt-extra=y
CONFIG_PACKAGE_kmod-ipt-raw=y
CONFIG_PACKAGE_kmod-ipt-socket=y
CONFIG_PACKAGE_kmod-ipt-ipset=y
CONFIG_PACKAGE_kmod-ipt-iprange=y
CONFIG_PACKAGE_kmod-ipt-tproxy=y
CONFIG_PACKAGE_kmod-ipt-conntrack-extra=y
CONFIG_PACKAGE_kmod-ipt-filter=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-bridge=y
CONFIG_PACKAGE_kmod-nf-tproxy=y
CONFIG_PACKAGE_kmod-nf-socket=y
CONFIG_PACKAGE_kmod-nfnetlink=y
CONFIG_PACKAGE_kmod-nf-nathelper=y
CONFIG_PACKAGE_kmod-nf-nathelper-extra=y
CONFIG_PACKAGE_kmod-nf-conntrack-netlink=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-netlink-diag=y
CONFIG_PACKAGE_kmod-wireguard=y

# ===== IPTV 组播转单播（igmpproxy / udpxy / msd_lite 零 kmod 依赖）=====
CONFIG_KERNEL_IP_MROUTE=y
CONFIG_KERNEL_IP_MULTICAST=y
CONFIG_KERNEL_BRIDGE_IGMP_SNOOPING=y

# ===== Docker：kmod 层（必须编入，跨源无解）=====
CONFIG_PACKAGE_kmod-fs-btrfs=y
CONFIG_PACKAGE_kmod-nf-ipvs=y
CONFIG_PACKAGE_kmod-ipt-nat=y
CONFIG_PACKAGE_kmod-ipt-nat6=y
CONFIG_PACKAGE_kmod-ipt-physdev=y
CONFIG_PACKAGE_kmod-ipt-conntrack=y
CONFIG_PACKAGE_kmod-nf-conntrack=y
CONFIG_PACKAGE_kmod-nf-nat=y
CONFIG_PACKAGE_kmod-nf-nat6=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-macvlan=y
CONFIG_PACKAGE_kmod-ipvlan=y
CONFIG_PACKAGE_kmod-br-netfilter=y
CONFIG_PACKAGE_kmod-dummy=y
CONFIG_PACKAGE_kmod-nft-compat=y

# ===== Docker：用户态运行时（已编入固件，装 dockerd 时不必再拉 38MB）=====
CONFIG_PACKAGE_containerd=y
CONFIG_PACKAGE_runc=y
CONFIG_PACKAGE_tini=y
CONFIG_PACKAGE_libseccomp=y
CONFIG_PACKAGE_cgroupfs-mount=y

# ===== 容器所需内核项 =====
# LEDE 的 Config-kernel.in 里 CGROUPS / NAMESPACES / SECCOMP / POSIX_MQUEUE
# 都是 default y if !SMALL_FLASH，玩客云非 small flash，不必重复写；
# VETH / MACVLAN / BRIDGE / OVERLAY_FS 由 kmod 或内核基线提供，也不要写 KERNEL_ 版本
CONFIG_KERNEL_CGROUP_DEVICE=y
CONFIG_KERNEL_CGROUP_FREEZER=y
CONFIG_KERNEL_CGROUP_NET_PRIO=y
CONFIG_KERNEL_NET_CLS_CGROUP=y
CONFIG_KERNEL_CGROUP_PIDS=y
CONFIG_KERNEL_CGROUP_CPUACCT=y
CONFIG_KERNEL_MEMCG=y

# ===== PHP 8（入口包，库自动带入）=====
CONFIG_PACKAGE_php8-cli=y
# CONFIG_PACKAGE_php8-fpm is not set
CONFIG_PACKAGE_php8-mod-openssl=y
CONFIG_PACKAGE_php8-mod-curl=y
CONFIG_PACKAGE_php8-mod-sockets=y
CONFIG_PACKAGE_php8-mod-mbstring=y
CONFIG_PACKAGE_php8-mod-session=y

# ===== 可选增补（按需，全部可删）=====
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-vxlan=y
CONFIG_PACKAGE_kmod-ipt-offload=y
CONFIG_PACKAGE_kmod-nft-netdev=y
CONFIG_PACKAGE_kmod-ifb=y
CONFIG_PACKAGE_kmod-ebtables=y
CONFIG_PACKAGE_kmod-arptables=y
