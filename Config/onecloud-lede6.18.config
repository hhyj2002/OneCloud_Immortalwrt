# end of Target Images

# CONFIG_EXPERIMENTAL is not set

# =====================================================================
# 以下为手工维护的包清单
# 版本：coolsnowwolf/lede master（opkg + ipk），target amlogic/meson8b，内核 6.18
# 架构：arm_cortex-a5_vfpv4
# 原则：只写"入口包"，库与依赖自动带入；kmod / targets 层必须编入固件
#
# 与 24.10 / 25.12 两份 config 的差异（均为源差异，不是遗漏）：
#   - LEDE 的 iptables 没有拆出 xtables-nft / xtables-legacy，也没有 iptables-zz-legacy
#   - LEDE 的 luci 仍是 lua 版：没有 luci-light / luci-lib-base / luci-mod-network /
#     luci-mod-status / luci-mod-system / luci-app-opkg，全部页面由 luci-mod-admin-full 提供
#   - LEDE 没有 liblucihttp / lua-neturl，不需要写
#   - LEDE 有 cgroupfs-mount 与 nfs-utils-libs（25.12 已移除）
#   - LEDE 的 KMOD 里没有 kmod-net-stmmac / kmod-net-meson-dwmac（见下方说明）
# =====================================================================

# ===== 基础系统 =====
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_rpcd=y
CONFIG_PACKAGE_kmod-zram=y
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_autocore-arm=y
CONFIG_PACKAGE_automount=y

# ===== dnsmasq-full（子选项控制编译特性，不是独立包）=====
CONFIG_PACKAGE_dnsmasq-full=y
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq_full_dhcp=y
CONFIG_PACKAGE_dnsmasq_full_dhcpv6=y
CONFIG_PACKAGE_dnsmasq_full_dnssec=y
CONFIG_PACKAGE_dnsmasq_full_auth=y
CONFIG_PACKAGE_dnsmasq_full_ipset=y
CONFIG_PACKAGE_dnsmasq_full_nftset=y
CONFIG_PACKAGE_dnsmasq_full_conntrack=y
CONFIG_PACKAGE_dnsmasq_full_noid=y
CONFIG_PACKAGE_dnsmasq_full_tftp=y

# ===== LuCI 基础（不含 docker / 科学上网 / IPTV 界面）=====
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
# 不选 luci-app-firewall：LEDE 的该包只声明 +firewall（fw3），
# 而 Package/firewall 的 CONFLICTS:=firewall4，选了会把 fw4 顶掉降级成 fw3
# CONFIG_PACKAGE_luci-theme-argon is not set
# CONFIG_PACKAGE_luci-theme-material is not set
# CONFIG_PACKAGE_luci-app-dockerman is not set
# CONFIG_PACKAGE_luci-app-ttyd is not set
# CONFIG_PACKAGE_luci-app-ddns is not set
# CONFIG_PACKAGE_luci-app-argon-config is not set

# ===== LuCI 的 lua 运行时依赖（LEDE 的 luci 是 lua 版，这些是真实存在的包）=====
CONFIG_PACKAGE_libiwinfo-lua=y
CONFIG_PACKAGE_liblua=y
CONFIG_PACKAGE_libubus-lua=y
CONFIG_PACKAGE_libuci-lua=y
CONFIG_PACKAGE_luci-lib-ip=y
CONFIG_PACKAGE_luci-lib-jsonc=y
CONFIG_PACKAGE_luci-lib-nixio=y
CONFIG_PACKAGE_luci-lua-runtime=y
CONFIG_PACKAGE_lua=y
CONFIG_HAS_LUAJIT_ARCH=y
CONFIG_LUA_ECO_MBEDTLS=n

# ===== SSH =====
CONFIG_PACKAGE_autossh=y
CONFIG_PACKAGE_openssh-client=y
CONFIG_PACKAGE_openssh-client-utils=y
CONFIG_PACKAGE_openssh-keygen=y
CONFIG_PACKAGE_openssh-moduli=y
CONFIG_PACKAGE_openssh-server=y
CONFIG_PACKAGE_openssh-sftp-client=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_openssh-sftp-avahi-service=y
# CONFIG_PACKAGE_openssh-server-pam is not set
# CONFIG_OPENSSH_LIBFIDO2 is not set

# ===== 常用命令行工具 =====
CONFIG_PACKAGE_mount-utils=y
