# 仅保留 Onliner（设备在线查看）
CONFIG_PACKAGE_luci-app-onliner=y
# 默认 bootstrap 主题
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_LUCI_LANG_zh_Hans=y

# ================= USB 有线网卡支持 =================
