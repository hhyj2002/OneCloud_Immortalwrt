# Automatically generated file; DO NOT EDIT.
# LEDE Configuration
#
CONFIG_MODULES=y
CONFIG_HAVE_DOT_CONFIG=y
CONFIG_HOST_OS_LINUX=y
# CONFIG_HOST_OS_MACOS is not set

CONFIG_TARGET_amlogic=y
CONFIG_TARGET_amlogic_meson8b=y
CONFIG_TARGET_amlogic_meson8b_DEVICE_thunder-onecloud=y
CONFIG_HAS_SUBTARGETS=y
CONFIG_HAS_DEVICES=y
CONFIG_TARGET_BOARD="amlogic"
CONFIG_TARGET_SUBTARGET="meson8b"
CONFIG_TARGET_PROFILE="DEVICE_thunder-onecloud"
CONFIG_TARGET_ARCH_PACKAGES="arm_cortex-a5_vfpv4"
CONFIG_DEFAULT_TARGET_OPTIMIZATION="-Os -pipe"
CONFIG_CPU_TYPE="cortex-a5+vfpv4"
CONFIG_TARGET_IMAGES_GZIP=y

# ================= 镜像格式强制配置 =================
# 强制生成 tar.gz，保证侦察兵脚本能抓到
CONFIG_TARGET_ROOTFS_TARGZ=y
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_ROOTFS_EXT4FS_IMG=y
CONFIG_TARGET_KERNEL_PARTSIZE=32
CONFIG_TARGET_ROOTFS_PARTSIZE=800

# ================= 基础系统 =================
CONFIG_PACKAGE_base-files=y
CONFIG_PACKAGE_busybox=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_opkg=y
CONFIG_PACKAGE_uci=y
CONFIG_PACKAGE_ubus=y
CONFIG_PACKAGE_ubox=y
CONFIG_PACKAGE_logd=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_libc=y
CONFIG_PACKAGE_libgcc=y

# ================= LuCI 界面 =================
CONFIG_PACKAGE_luci=y
